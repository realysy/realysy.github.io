---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE_CONFIG } from '@/utils/config';

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';
---
<Layout 
  lang="en"
  title=`Privacy Policy - ${SITE_CONFIG.siteName}` 
  description=`${SITE_CONFIG.siteName}: Privacy Policy is introduced in this page.`
>
  <div class="page-wrapper">
    <Header />
    <div class="container markdown-content">
      <h1>Privacy Policy</h1>
      <p class="last-updated"><strong>Last Updated:</strong> June 27, 2026</p>
      <p>This website (mctek.site / realysy.github.io) serves as a personal portfolio and showcase for my projects and experiments.</p>
      <h2>1. No Data Collection</h2>
      <p>This website <strong>does not</strong> collect, track, or store any personal information, cookies, or analytics data from visitors. There are no advertisements or third-party tracking scripts embedded in these pages.</p>
      <h2>2. Third-Party Links</h2>
      <p>This site may contain links to external platforms such as GitHub, YouTube, itch.io, or Taobao. These third-party services have their own privacy policies, and we are not responsible for their data practices.</p>
      <h2>3. Software Products</h2>
      <p>Some projects showcased on this site are standalone software applications (e.g., SSH Config Manager). <strong>The privacy policies and End-User License Agreements (EULA) for those specific software products are governed by the agreements presented within the software itself upon installation or activation.</strong> This website's privacy policy does not override the specific terms of those software products.</p>
      <a href={baseUrl} class="back-link" style="display: inline-block; margin-top: 24px; color: #667eea; text-decoration: none; font-weight: 500;">← Back to Home</a>
    </div>
    <Footer />
  </div>
</Layout>