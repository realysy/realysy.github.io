---
/**
 * src/pages/index.astro
 * 个人主页：自我介绍 + 项目展示
 */

import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProjectCard from '@/components/ProjectCard.astro';
---

<Layout title="realysy homepage - projects & writing">
  <Header />
  <main>
    <section class="hero">
      <!-- 无 eyebrow，无 version 标签，无 scroll cue -->
      <h2>Developer, tinkerer.</h2>
      <p>I build tools, apps that make life easier. Currently focused on SSH Config Manager and related utilities.</p>
      <div class="cta-group">
        <a href="#projects" class="primary-btn">View projects</a>
        <a href="https://github.com/realysy" target="_blank" rel="noopener" class="secondary-btn">GitHub</a>
      </div>
      <!-- 没有 trust strip、没有 pricing teaser、没有 tagline below CTAs -->
    </section>

    <section id="projects" class="projects-section">
      <h3>Projects</h3>
      <div class="project-grid">
        <!-- 第一个项目占据较大网格，第二个项目可后续添加 -->
        <ProjectCard 
          title="SSH Config Manager" 
          description="A cross-platform tool for group-based visual management of SSH connections. Features a built-in SFTP file manager (including a code editor) and integrates with Wezterm, Kitty, Alacritty, Windows Terminal, and more." 
          href="/ssh-config-manager-artifact/" 
        />
        <!-- 第二个项目占位（当有新项目时启用） -->
        <!-- <ProjectCard title="Another Project" description="Description" href="/another/" /> -->
      </div>
    </section>
  </main>
  <Footer />
</Layout>