---
/**
 * src/pages/zh/index.astro
 * 个人主页: 自我介绍 + 项目展示
 */

import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProjectCard from '@/components/ProjectCard.astro';
---

<Layout title="realysy 主页 - 项目与文章">
  <Header />
  <main>
    <section class="hero">
      <!-- 无 eyebrow, 无 version 标签, 无 scroll cue -->
      <h1>开发者, 极客.</h1>
      <p>我开发工具和让生活更便捷的应用. 目前专注于 SSH Config Manager 及相关实用工具.</p>
      <div class="cta-group">
        <a href="#projects" class="primary-btn">查看项目</a>
        <a href="https://github.com/realysy" target="_blank" rel="noopener" class="secondary-btn">GitHub</a>
      </div>
      <!-- 没有 trust strip, 没有 pricing teaser, 没有 tagline below CTAs -->
    </section>

    <section id="projects" class="projects-section">
      <h2>项目</h2>
      <div class="project-grid">
        <!-- 第一个项目占据较大网格 -->
        <ProjectCard 
          title="SSH Config Manager" 
          description="一款支持分组可视化的 SSH 配置管理器, 深度集成现代终端模拟器." 
          href="/ssh-config-manager-artifact/" 
        />
        
        <!-- ✨ 第二个项目：C++ 文件管理库 (带有 YouTube 演示视频) -->
        <div class="project-card">
          <h3>C++ 文件管理库 (带 WebUI)</h3>
          <p>一个带有 HTTP 接口和 WebUI 界面的 C++ 文件管理库，可用于远程管理机器中的文件（如开发、调试机器人）。</p>
          <div class="video-wrapper">
            <iframe 
              src="https://www.youtube.com/embed/dZEh1HSGWWo?si=BYJqPuKuHf8XUNUv&controls=0" 
              title="C++ 文件管理器 WebUI 演示" 
              frameborder="0" 
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
              referrerpolicy="strict-origin-when-cross-origin" 
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>