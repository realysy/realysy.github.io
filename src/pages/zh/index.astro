---
/**
 * src/pages/index.astro
 * 个人主页: 自我介绍 + 项目展示
 */

import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ProjectCard from '@/components/ProjectCard.astro';
---

<Layout 
  lang="zh"
  title="realysy 的主页 - 主要项目与博客文章"
  description="realysy 的个人主页, 展示主要项目和博客文章, 包含已完成的项目和正在进行的项目, 目前正在开发 SSH Config Manager 及相关实用工具."
>
  <Header />
  <main>
    <section class="hero">
      <!-- 无 eyebrow, 无 version 标签, 无 scroll cue -->
      <h2>开发者, 极客.</h2>
      <p>我开发工具和让生活更便捷的应用. 目前专注于 SSH Config Manager 及相关实用工具.</p>
      <div class="cta-group">
        <a href="#projects" class="primary-btn">查看项目</a>
        <a href="https://github.com/realysy" target="_blank" rel="noopener" class="secondary-btn">GitHub</a>
      </div>
      <!-- 没有 trust strip, 没有 pricing teaser, 没有 tagline below CTAs -->
    </section>

    <section id="projects" class="projects-section">
      <h3>项目</h3>
      <div class="project-grid">
        <!-- 第一个项目占据较大网格, 第二个项目可后续添加 -->
        <ProjectCard 
          title="SSH Config Manager" 
          description="一款支持分组可视化的 SSH 连接管理器, 深度集成现代终端模拟器." 
          href="/ssh-config-manager-artifact/" 
        />
        <!-- 第二个项目占位 (当有新项目时启用) -->
        <!-- <ProjectCard title="另一个项目" description="项目描述" href="/another/" /> -->
      </div>
    </section>
  </main>
  <Footer />
</Layout>