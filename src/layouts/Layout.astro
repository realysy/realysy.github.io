---
// src/layouts/Layout.astro
import '@/styles/global.css';
import { getLangFromPath, localizePath } from '@/utils/i18n'; 

export interface Props {
  title: string;
  lang?: string;
  description?: string;
  image?: string; // 建议预留 image 接口, 方便以后接入 og:image
}

const {
  title, 
  lang = 'en', 
  description = "realysy's homepage site - projects and writings.",
  image
} = Astro.props;

// 获取 base 路径, 用于拼接静态资源
let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';

const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).toString();

// 🛡️ 核心修复: 计算完整的双向 hreflang 链接, 避免 Google 判定为配置错误
const isZh = lang === 'zh';
const alternatePath = localizePath(currentPath, isZh ? 'en' : 'zh', baseUrl);
const alternateUrl = new URL(alternatePath, Astro.site).toString();
const xDefaultUrl = new URL(baseUrl, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

  <!-- 基础 SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- 🛡️ 核心修复: 多语言 Hreflang 标签 (必须双向引用, 否则 Google 会忽略) -->
  <link rel="alternate" hreflang={lang} href={canonicalUrl} />
  <link rel="alternate" hreflang={isZh ? 'en' : 'zh'} href={alternateUrl} />
  <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

  <!-- Open Graph / 社交媒体分享卡片 -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {image && <meta property="og:image" content={new URL(image, Astro.site).toString()} />}
  
  <!-- 🛡️ 核心修复: Twitter 分享卡片 (无大图时降级为 summary, 避免爬虫报错) -->
  <meta property="twitter:card" content={image ? "summary_large_image" : "summary"} />
  <meta property="twitter:url" content={canonicalUrl} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  {image && <meta property="twitter:image" content={new URL(image, Astro.site).toString()} />}

  <!-- 🛡️ 核心修复: Favicon 使用 baseUrl 动态拼接, 防止子路径部署时 404 -->
  <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  <link rel="icon" type="image/x-icon" href={`${baseUrl}favicon.ico`} />
  
  <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />
  
  <!-- 引入配置文件, 包含 window.supportEmail 等变量 -->
  <script is:inline src={`${baseUrl}config.js`}></script>

  <!-- 暗色模式初始脚本, 防止闪烁 -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>

<body>
  <div class="page-wrapper">
    <slot />
  </div>
</body>

</html>
