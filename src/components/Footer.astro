---
/** src/components/Footer.astro
 * 页脚：版权及链接
 */

let baseUrl = import.meta.env.BASE_URL;
if (!baseUrl.endsWith('/')) baseUrl += '/';
const currentPath = Astro.url.pathname;
const isZh = currentPath.includes('/zh/');
---

<footer class="footer">
  <div class="footer-links">
    <a href={`${baseUrl}${isZh ? 'zh/' : ''}templates/privacy/`}>{isZh ? "隐私政策" : "Privacy Policy"}</a>
    <a href={`${baseUrl}${isZh ? 'zh/' : ''}templates/terms/`}>{isZh ? "使用条款" : "Terms of Use"}</a>
  </div>
  <p>{isZh ? "© 2026 realysy. 保留所有权利." : "© 2026 realysy. All rights reserved."}</p>
</footer>