---
/** src/components/ProjectCard.astro
 * 项目卡片组件：标题、简述、链接
 */

export interface Props {
  title: string;
  description: string;
  href: string;
  lang?: string;
}

const { title, description, href, lang = 'en' } = Astro.props;
---

<div class="project-card">
  <h3>{title}</h3>
  <p>{description}</p>
  <a href={href}>{lang === 'zh' ? '了解更多' : 'Learn more'}</a>
</div>